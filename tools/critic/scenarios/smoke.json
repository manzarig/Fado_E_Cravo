{
  "comment": "Smoke test of M3 + M4: two radios on Radio Tejo, switching on (redstone pulse and screen button), tuning, distance falloff, off air by day and on air at night, breaking news. About 3 minutes of game time. Layout: radio A at (0,-60,3) facing north, 3 blocks in front of the player at (0.5,-60,0.5) who looks south (yaw 0); radio B at (6,-60,0) facing west, 6 blocks to the side. The flat world's grass is at y=-61. The daylight cycle stays on (the default): with the time frozen the radios deliberately stop following the schedule and would not stay in sync with each other. Every stage that needs a time of day sets it.",
  "settings": {
    "snapshot_every_ticks": 20,
    "gui_scale": 3,
    "lang": "en_us"
  },
  "steps": [
    {"note": "STAGE 0: clean flat world, daytime, player at the origin looking at where radio A will stand"},
    {"cmd": "time set 6000"},
    {"cmd": "fill -12 -60 -12 12 -50 12 air"},
    {"cmd": "kill @e[type=!player]"},
    {"tp": [0.5, -60, 0.5, 0, 15]},
    {"wait": 20},

    {"note": "STAGE 1: place both radios, switched off, on 1035 kHz"},
    {"cmd": "setblock 0 -60 3 fadoecravo:radio[facing=north,on=false]{frequency:1035} replace"},
    {"cmd": "setblock 6 -60 0 fadoecravo:radio[facing=west,on=false]{frequency:1035} replace"},
    {"wait": 20},
    {"snapshot": "placed_off"},
    {"shot": "radio_off_in_front"},
    {"hide_hud": true},
    {"tp": [0.5, -60, 2.0, 0, 36]},
    {"wait": 10},
    {"shot": "radio_off_closeup_no_hud"},
    {"hide_hud": false},
    {"tp": [0.5, -60, 0.5, 0, 15]},
    {"wait": 20},

    {"note": "STAGE 2: switch radio A on with a redstone pulse (on at the rising edge, nothing at the falling edge)"},
    {"mark": "before_pulse"},
    {"wait": 30},
    {"cmd": "setblock 0 -60 4 minecraft:redstone_block"},
    {"wait": 40},
    {"snapshot": "after_redstone_on"},
    {"cmd": "setblock 0 -60 4 air"},
    {"wait": 20},
    {"snapshot": "after_redstone_removed_still_on"},
    {"shot": "radio_a_on_by_redstone"},

    {"note": "STAGE 2b: switch radio B on with the power button on its screen (TogglePowerPayload)"},
    {"open": [6, -60, 0]},
    {"wait": 10},
    {"shot": "screen_radio_b_before_power"},
    {"click_power": true},
    {"wait": 20},
    {"shot": "screen_radio_b_after_power"},
    {"close": true},
    {"wait": 20},
    {"snapshot": "both_on_sync_check_1"},
    {"wait": 100},
    {"snapshot": "both_on_sync_check_2"},
    {"tp": [3.5, -60, -4.5, 0, 12]},
    {"wait": 40},
    {"snapshot": "wide_view"},
    {"shot": "both_radios_on_wide_view"},
    {"tp": [0.5, -60, 0.5, 0, 15]},
    {"wait": 20},

    {"note": "STAGE 3: tuning radio A through its screen"},
    {"open": [0, -60, 3]},
    {"wait": 10},
    {"shot": "screen_a_1035_tejo"},
    {"click_dial_khz": 670},
    {"wait": 15},
    {"snapshot": "tuned_670"},
    {"shot": "screen_a_670_lusitana"},
    {"click_dial_khz": 850},
    {"wait": 15},
    {"snapshot": "tuned_850_off_station"},
    {"shot": "screen_a_850_static"},
    {"key": "right", "repeat": 5},
    {"key": "left", "repeat": 2, "shift": true},
    {"scroll": 3},
    {"scroll": -1, "shift": true},
    {"wait": 15},
    {"snapshot": "tuned_by_keys_and_wheel"},
    {"drag_dial_khz": [850, 1035]},
    {"wait": 15},
    {"snapshot": "dragged_back_to_1035"},
    {"shot": "screen_a_dragged_to_1035"},
    {"close": true},
    {"wait": 20},

    {"note": "STAGE 3b: switch radio B off again through its screen, so the distance test hears radio A only"},
    {"open": [6, -60, 0]},
    {"wait": 5},
    {"click_power": true},
    {"wait": 10},
    {"close": true},
    {"wait": 30},
    {"snapshot": "b_off_a_alone"},

    {"note": "STAGE 4: distance falloff from radio A at (0,-60,3): 8, 32, 48, 64 and 80 blocks along +z, looking back at it"},
    {"tp": [0.5, -60, 11.5, 180, 0]},
    {"wait": 60},
    {"mark": "distance_8"},
    {"wait": 80},
    {"snapshot": "distance_8"},
    {"shot": "distance_8"},
    {"wait": 20},
    {"tp": [0.5, -60, 35.5, 180, 0]},
    {"wait": 80},
    {"mark": "distance_32"},
    {"wait": 80},
    {"snapshot": "distance_32"},
    {"shot": "distance_32"},
    {"wait": 20},
    {"tp": [0.5, -60, 51.5, 180, 0]},
    {"wait": 80},
    {"mark": "distance_48"},
    {"wait": 80},
    {"snapshot": "distance_48"},
    {"shot": "distance_48"},
    {"wait": 20},
    {"tp": [0.5, -60, 67.5, 180, 0]},
    {"wait": 80},
    {"mark": "distance_64"},
    {"wait": 80},
    {"snapshot": "distance_64"},
    {"shot": "distance_64"},
    {"wait": 20},
    {"tp": [0.5, -60, 83.5, 180, 0]},
    {"wait": 80},
    {"mark": "distance_80"},
    {"wait": 80},
    {"snapshot": "distance_80_out_of_range"},
    {"shot": "distance_80"},
    {"wait": 20},

    {"note": "STAGE 5: Radio Atlantico (1440 kHz) is silent by day (carrier hiss only) and on the air at night"},
    {"tp": [0.5, -60, 0.5, 0, 15]},
    {"cmd": "time set 6000"},
    {"wait": 40},
    {"open": [0, -60, 3]},
    {"wait": 10},
    {"click_dial_khz": 1440},
    {"wait": 20},
    {"snapshot": "day_tuned_1440_off_air"},
    {"shot": "screen_day_1440_off_air"},
    {"close": true},
    {"wait": 20},
    {"mark": "day_1440_off_air"},
    {"wait": 80},
    {"snapshot": "day_1440_world"},
    {"cmd": "time set 18000"},
    {"wait": 60},
    {"snapshot": "night_1440_on_air"},
    {"open": [0, -60, 3]},
    {"wait": 10},
    {"shot": "screen_night_1440_atlantico"},
    {"close": true},
    {"wait": 40},
    {"mark": "night_1440"},
    {"wait": 100},
    {"snapshot": "night_1440_world"},
    {"shot": "world_night_1440_subtitles"},

    {"note": "STAGE 6: breaking news on Radio Tejo, daytime, radio A back on 1035"},
    {"cmd": "time set 6000"},
    {"open": [0, -60, 3]},
    {"wait": 10},
    {"click_dial_khz": 1035},
    {"wait": 15},
    {"close": true},
    {"wait": 60},
    {"snapshot": "before_breaking"},
    {"mark": "before_breaking"},
    {"wait": 60},
    {"cmd": "fadoecravo breaking radio_tejo"},
    {"wait": 30},
    {"snapshot": "breaking_started"},
    {"shot": "breaking_news_subtitles"},
    {"wait": 200},
    {"snapshot": "breaking_10s"},
    {"wait": 200},
    {"snapshot": "breaking_20s"},
    {"shot": "breaking_news_20s"},
    {"cmd": "fadoecravo breaking clear"},
    {"wait": 60},
    {"snapshot": "breaking_cleared"},

    {"quit": true}
  ]
}
